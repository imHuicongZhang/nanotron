new file mode 100644
index 00000000..b97a2404
--- /dev/null
+++ b/configs/legacy-arr/config_15B-base_15B_1.5B.yaml
@@ -0,0 +1,89 @@
+general:
+  project: exp-0616
+  run: quality-base-15B-1.5B-seed42
+  seed: 42
+model:
+  ddp_bucket_cap_mb: 25
+  dtype: bfloat16
+  init_method: {std: 0.02}
+  make_vocab_size_divisible_by: 1
+  model_config:
+    is_llama_config: true
+    hidden_size: 2048
+    num_hidden_layers: 28
+    num_attention_heads: 16
+    num_key_value_heads: 16
+    intermediate_size: 5632
+    vocab_size: 32000
+    tie_word_embeddings: true
+    hidden_act: silu
+    max_position_embeddings: 2048
+    rope_theta: 10000.0
+    rope_interleaved: false
+    rms_norm_eps: 1.0e-5
+    attention_bias: false
+    bos_token_id: 1
+    eos_token_id: 2
+    pad_token_id: null
+    pretraining_tp: 1
+    use_cache: false
+tokenizer:
+  tokenizer_name_or_path: /scratch/bvandur1/zhuicon1/tokenizers/llama2-unsloth-tokenizer
+tokens:
+  sequence_length: 2048
+  train_steps: 21458
+  micro_batch_size: 4
+  batch_accumulation_per_replica: 64  # dp4: 4*4*64 = 1024 seq = 2,097,152 tok/step (global batch unchanged)
+  val_check_interval: -1
+  limit_val_batches: 0
+  limit_test_batches: 0
+parallelism:
+  dp: 4
+  tp: 1
+  pp: 1
+  expert_parallel_size: 1
+  pp_engine: 1f1b
+  tp_mode: REDUCE_SCATTER
+  tp_linear_async_communication: true
+data_stages:
+- name: S0_top10B
+  start_training_step: 1
+  data:
+    dataset:
+      dataset_folder:
+        - /scratch/bvandur1/zhuicon1/nanotron_tokenized/15B-base/tokenized
+    num_loading_workers: 1
+    seed: 42
+checkpoints:
+  checkpoints_path: /scratch/bvandur1/zhuicon1/checkpoints/quality-base-15B-1.5B-seed42
+  resume_checkpoint_path: /scratch/bvandur1/zhuicon1/checkpoints/_init_1.5B_seed42/0  # shared init (weights only)
+  load_optimizer: false
+  load_lr_scheduler: false
+  checkpoint_interval: 477  # ~1B tokens: 477 * 2,097,152 tok/step = 1.0003B (tok/step = mbs4*accum64*dp4*seq2048)
+  save_initial_state: false   # loads shared init via resume_checkpoint_path; does not regenerate
+  save_final_state: true
+optimizer:
+  zero_stage: 0  # was 1; ZeRO-1 + accumulate_grad_in_fp32 is NotImplemented in nanotron 0.4 (fp32_accum_hook reduce_scatter path). zero_stage 0 keeps fp32 grad accumulation.
+  weight_decay: 0.1
+  clip_grad: 1.0
+  accumulate_grad_in_fp32: true
+  learning_rate_scheduler:
+    # WSD (Warmup-Stable-Decay), SmolLM2-1.7B recipe shape.
+    # Boundaries derived from train_steps=14305 (see tokens block):
+    #   warmup 0->500 | stable 500->12875 (flat @ 5e-4) | decay 12875->14305 (linear -> 0)
+    #   lr_decay_starting_step = round(0.90*14305)=12875 ; lr_decay_steps = 14305-12875 = 1430 (last 10%)
+    learning_rate: 5.0e-4
+    lr_warmup_steps: 500
+    lr_warmup_style: linear
+    lr_decay_starting_step: 19312
+    lr_decay_style: linear
+    lr_decay_steps: 2146
+    min_decay_lr: 0.0
+  optimizer_factory:
+    adam_beta1: 0.9
+    adam_beta2: 0.95
+    adam_eps: 1.0e-8
+    name: adamW
+    torch_adam_is_fused: true
+logging:
+  iteration_step_info_interval: 1
