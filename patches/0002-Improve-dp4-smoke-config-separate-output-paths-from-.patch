From 0d34de1be9020655e96123d7c197c707040a404f Mon Sep 17 00:00:00 2001
From: Huicong Zhang <zhuicon1@jh.edu>
Date: Mon, 18 May 2026 13:45:21 -0400
Subject: [PATCH 2/6] Improve dp4 smoke config: separate output paths from
 single-GPU run

---
 smoke_test/config_smoke_dp4.yaml | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/smoke_test/config_smoke_dp4.yaml b/smoke_test/config_smoke_dp4.yaml
index 0e3d71b8..abde8410 100644
--- a/smoke_test/config_smoke_dp4.yaml
+++ b/smoke_test/config_smoke_dp4.yaml
@@ -1,6 +1,6 @@
 checkpoints:
   checkpoint_interval: 10000
-  checkpoints_path: smoke_test/checkpoints
+  checkpoints_path: smoke_test/checkpoints_dp4
   checkpoints_path_is_shared_file_system: false
   resume_checkpoint_path: null
   save_initial_state: false
@@ -12,11 +12,11 @@ data_stages:
   name: Smoke Stage
   start_training_step: 1
 general:
-  benchmark_csv_path: smoke_test/benchmark.csv
+  benchmark_csv_path: smoke_test/benchmark_dp4.csv
   consumed_train_samples: null
   ignore_sanity_checks: true
   project: smoke
-  run: t4_smoke
+  run: h200_dp4_smoke
   seed: 42
   step: null
 lighteval: null
